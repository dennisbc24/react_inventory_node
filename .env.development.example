NODE_ENV=development
DB_USER=postgres
DB_PASSWORD=tu_pass
DB_NAME=inventary
DB_HOST=127.0.0.1
DB_PORT=5433
JWT_SECRET=dev_secret
AWS_REGION=sa-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=caja-for-many-products-dennis
# Forecasting (opcional): job diario del snapshot y pool de sólo lectura
# En desarrollo el scheduler está apagado por defecto (la DB es compartida con
# producción). Para probarlo localmente, descomentar:
# FORECASTING_SNAPSHOT_ENABLED=true
# FORECASTING_SNAPSHOT_HOUR=9
# FORECASTING_SNAPSHOT_MINUTE=0
# FORECASTING_SNAPSHOT_JITTER_MINUTES=15
# FORECASTING_SNAPSHOT_PATH=services/forecasting/artifacts/restock_snapshot.json.gz
# FORECASTING_REFRESH_COOLDOWN_MS=900000
# FORECASTING_CATALOG_TTL_MS=43200000
# FORECASTING_DB_POOL_MAX=2
# FORECASTING_DB_STATEMENT_TIMEOUT_MS=120000
# 1. Abre túnel SSM antes de npm run dev:
# aws ssm start-session --target "i-00022dbcb1ddd4206" --document-name AWS-StartPortForwardingSession --parameters '{"portNumber":["5432"],"localPortNumber":["5433"]}'
# 2. npm run dev (usa 127.0.0.1:5433 sin ssl)
